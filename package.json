{
  "name": "doclk-channel-watcher",
  "version": "1.0.1",
  "description": "Monitor Doc.lk doctor channel pages and notify Telegram when appointments open.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/VihangaDev/doclk-channel-watcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VihangaDev/doclk-channel-watcher.git"
  },
  "bugs": {
    "url": "https://github.com/VihangaDev/doclk-channel-watcher/issues"
  },
  "bin": {
    "doclk-watch": "src/monitor.js"
  },
  "files": [
    "docs",
    "public",
    "src",
    "launchd",
    "systemd",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md"
  ],
  "scripts": {
    "check": "node src/monitor.js --once",
    "web": "node src/community-service.js",
    "start": "node src/monitor.js",
    "telegram:test": "node src/verify-telegram.js",
    "test": "node --test"
  },
  "keywords": [
    "doclk",
    "doc990",
    "doctor",
    "appointments",
    "telegram",
    "monitor"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1"
  }
}
