# One URL:
DOCLK_URL=https://www.doc.lk/channel/31317

# Or many URLs, comma-separated or newline-separated:
# DOCLK_URLS=https://www.doc.lk/channel/31317,https://www.doc.lk/channel/3012

CHECK_INTERVAL_SECONDS=60
FETCH_TIMEOUT_SECONDS=20
ERROR_NOTIFY_AFTER=3
STATE_FILE=.state/doclk-watcher-state.json

# Create a bot with @BotFather, then send a message to the bot and read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: send a startup message when the monitor begins.
NOTIFY_ON_START=false
